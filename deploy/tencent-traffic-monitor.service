[Unit]
Description=Tencent Cloud CSS Traffic Monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tencent-traffic-monitor
Group=tencent-traffic-monitor
WorkingDirectory=/opt/tencent-traffic-monitor
ExecStart=/opt/tencent-traffic-monitor/.venv/bin/python -m traffic_monitor --config /etc/tencent-traffic-monitor/config.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0027
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tencent-traffic-monitor
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
